<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Workout Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-3">
  <div class="container">
    <div style="text-align:right; margin-bottom: 10px;">
      Goal: <%= fitnessGoal %> | <a href="/logout">Logout</a>
    </div>
    <p><a href="/workouts">Back</a></p>
    <h1><%= workout.workoutType %></h1>
    <p><strong>Duration:</strong> <%= workout.duration %></p>
    <p><strong>Calories Burned:</strong> <%= workout.caloriesBurned %></p>
    <p><strong>Workout Date:</strong> <%= new Date(workout.workoutDate).toISOString().slice(0, 10) %></p>
    <p><strong>Notes:</strong> <%= workout.notes %></p>
    <p>
      <a href="/workouts/<%= workout._id %>/edit">Edit</a>
    </p>
    <form method="POST" action="/workouts/<%= workout._id %>?_method=DELETE">
      <button class="btn btn-danger" type="submit">Delete</button>
    </form>
  </div>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script defer src="/js/validation.js"></script>
</head>
<body class="p-3">
  <div class="container">
    <p><a href="/login">Login</a></p>
    <h1>Register</h1>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form class="needs-validation" novalidate method="POST" action="/register">
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" id="username" name="username" type="text" value="<%= values.username || '' %>" required />
        <div class="invalid-feedback">Username is required.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" required />
        <div class="invalid-feedback">Password is required.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="age">Age</label>
        <input class="form-control" id="age" name="age" type="number" min="1" step="1" value="<%= values.age || '' %>" required />
        <div class="invalid-feedback">Age is required.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="gender">Gender</label>
        <select class="form-select" id="gender" name="gender" required>
          <option value="" disabled <%= !values.gender ? 'selected' : '' %>>Choose...</option>
          <option value="Male" <%= values.gender === 'Male' ? 'selected' : '' %>>Male</option>
          <option value="Female" <%= values.gender === 'Female' ? 'selected' : '' %>>Female</option>
          <option value="Other" <%= values.gender === 'Other' ? 'selected' : '' %>>Other</option>
        </select>
        <div class="invalid-feedback">Gender is required.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="fitnessGoal">Fitness Goal</label>
        <input class="form-control" id="fitnessGoal" name="fitnessGoal" type="text" value="<%= values.fitnessGoal || '' %>" required />
        <div class="invalid-feedback">Fitness goal is required.</div>
      </div>
      <button class="btn btn-primary" type="submit">Create Account</button>
    </form>
  </div>
</body>
</html>

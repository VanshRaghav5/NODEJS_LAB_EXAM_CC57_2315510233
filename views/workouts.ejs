<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Workouts</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-3">
  <div class="container">
    <div style="text-align:right; margin-bottom: 10px;">
      Goal: <%= fitnessGoal %> | <a href="/logout">Logout</a>
    </div>
    <h1>Workouts</h1>
    <p><a href="/workout/new">Add New Workout</a></p>

    <% if (workouts.length === 0) { %>
      <p>No workouts yet.</p>
    <% } else { %>
      <table class="table table-bordered">
        <tr>
          <th>Workout Type</th>
          <th>Duration</th>
          <th>Calories Burned</th>
          <th>Workout Date</th>
          <th>Actions</th>
        </tr>
        <% workouts.forEach(function (workout) { %>
          <tr>
            <td><%= workout.workoutType %></td>
            <td><%= workout.duration %></td>
            <td><%= workout.caloriesBurned %></td>
            <td><%= new Date(workout.workoutDate).toISOString().slice(0, 10) %></td>
            <td>
              <a href="/workouts/<%= workout._id %>">View</a> |
              <a href="/workouts/<%= workout._id %>/edit">Edit</a>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>
</body>
</html>
